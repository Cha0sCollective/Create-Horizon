+        Ok(PreparationClosed {
+            original_error: self.owner().original_error.clone(),
+            read_refusals: self.owner().read_refusals.clone(),
+            cancelled: self.owner().cancelled,
+            entry_token: self
+                .owner()
+                .entry_token
+                .as_ref()
+                .map(|entry| RetainedEntryIdentity {
+                    token: entry.token,
+                    owner: entry.owner.clone(),
+                }),
