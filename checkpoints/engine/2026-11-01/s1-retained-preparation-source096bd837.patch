+        .is_some_and(|handle| !handle.is_finished());
+    let pending = loader.poll_retained_outcome().is_none();
+    let excluded = SessionLock::acquire(&root).is_err();
+    if !(entered && unfinished && pending && excluded) {
+        let _ = release.send(());
+        let outcome = harvest(&mut loader);
+        close(&game, outcome);
