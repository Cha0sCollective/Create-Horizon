+/// Dormant lock-only partial acquisition. The caller's native world lock is a
+/// separate owner and is neither consumed nor released by this custody.
+/// Existing trusted regular/unlinked path checks are preserved; hostile external
+/// rename/inode replacement is not newly hardened by this prerequisite.
+pub(in crate::game) struct RetainedAuthorityAcquisition {
+    namespace: AuthorityNamespace,
+    key: PathBuf,
+    world: WorldId,
+    lock: horizon_client::save::RetainedSessionLock,
+    ready: bool,
+    first_failure: Option<String>,
+    #[cfg(test)]
+    hide_namespace_after_acquire: bool,
+}
+impl AuthorityNamespace {
+    pub(in crate::game) fn retained_acquisition(&self, world: WorldId) -> Result<RetainedAuthorityAcquisition> {
+        let key = self.checked_key(world)?;
+        Ok(RetainedAuthorityAcquisition {
+            namespace: self.clone(), lock: horizon_client::save::RetainedSessionLock::new(&key),
+            key, world, ready: false, first_failure: None,
+            #[cfg(test)] hide_namespace_after_acquire: false,
+        })
+    }
+}
+impl RetainedAuthorityAcquisition {
+    pub(in crate::game) fn acquired(&self) -> bool { self.lock.acquired() }
+    pub(in crate::game) fn ready(&self) -> bool { self.ready && self.lock.ready() }
+    pub(in crate::game) fn first_failure(&self) -> Option<&str> { self.first_failure.as_deref() }
+    fn remember<T>(&mut self, result: Result<T>) -> Result<T> {
+        if let Err(error) = &result { self.first_failure.get_or_insert_with(|| error.to_string()); }
+        result
+    }
+    fn same_route(&self, namespace: &AuthorityNamespace, world: WorldId) -> Result<()> {
+        if namespace.root != self.namespace.root || world != self.world {
+            return Err(failure("retained authority", "namespace/world correlation mismatch").into());
+        }
+        Ok(())
+    }
+    fn recheck(&self) -> Result<()> {
+        if self.namespace.checked_key(self.world)? != self.key {
+            return Err(failure("retained authority", "checked key changed").into());
+        }
+        lock_path(&self.key)
+    }
+    pub(in crate::game) fn acquire(&mut self) -> Result<()> {
+        if self.lock.acquired() { return Err("authority lock already acquired; repair same custody".into()); }
+        let result = (|| -> Result<()> {
+            self.recheck()?;
+            self.lock.acquire()?; // Actual partial File custody already installed.
+            #[cfg(test)]
+            if self.hide_namespace_after_acquire {
+                self.hide_namespace_after_acquire = false;
+                fs::rename(&self.namespace.root, self.namespace.root.with_extension("retained-held"))?;
+                fs::write(&self.namespace.root, b"controlled post-lock non-directory namespace")?;
+            }
+            self.recheck()?;
+            self.ready = true;
+            Ok(())
+        })();
+        self.remember(result)
+    }
+    pub(in crate::game) fn repair(&mut self, namespace: &AuthorityNamespace, world: WorldId) -> Result<()> {
+        self.same_route(namespace, world)?;
+        self.ready = false;
+        let result = (|| -> Result<()> {
+            self.lock.repair(&self.key)?; // Same File, never reopen/reacquire.
+            self.recheck()?;
+            self.ready = true;
+            Ok(())
+        })();
+        self.remember(result)
+    }
+    pub(in crate::game) fn finish(&mut self, namespace: &AuthorityNamespace, world: WorldId) -> Result<WorldAuthority> {
+        self.same_route(namespace, world)?;
+        if !self.ready() { return Err("retained authority is not fully validated".into()); }
+        let result = self.recheck();
+        if result.is_err() { self.ready = false; }
+        self.remember(result)?;
+        let lock = self.lock.finish(&self.key)?;
+        self.ready = false;
+        // No fallible operation after taking the actual ready lock.
+        Ok(WorldAuthority { world: self.world, _authority_lock: lock, _anchor_lock: None })
+    }
+    /// Only the authority lock owned here. Never releases the caller's native
+    /// owner lock or claims producer/writer/PreparationClosed completion.
+    pub(in crate::game) fn release_lock_only(&mut self) -> Result<()> {
+        self.ready = false;
+        let result = self.lock.release_lock_only();
+        self.remember(result)
+    }
+}
+impl Drop for RetainedAuthorityAcquisition {
+    fn drop(&mut self) {
+        if self.lock.acquired() {
+            use std::io::Write;
+            let _ = writeln!(std::io::stderr().lock(), "fatal: unresolved retained world authority acquisition");
+            std::process::abort();
+        }
+    }
+}
