+    }
+    fn enter(self: Arc<Self>, index: usize) -> LoaderWorkerObservation {
+        let guard = LoaderWorkerObservation { control: self.clone(), index };
+        let mut state = self.observation.lock().unwrap();
+        state.entered[index] = true;
+        state.named[index] = std::thread::current().name() == Some("Worldgen loader");
+        self.event.notify_all();
+        while self.hold[index] && !state.released { state = self.event.wait(state).unwrap(); }
+        drop(state);
+        if self.panic_child == Some(index) { panic!("controlled actual Worldgen loader panic"); }
+        guard
+    }
+    fn wait_for(&self, started: usize, body_done: bool) -> bool {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(120);
+        let mut state = self.observation.lock().unwrap();
+        while (body_done && !state.body_done) || !state.entered[..started].iter().all(|entered| *entered) {
+            let Some(left) = deadline.checked_duration_since(std::time::Instant::now()) else { return false; };
+            let waited = self.event.wait_timeout(state, left).unwrap();
